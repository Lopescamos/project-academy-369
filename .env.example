# Copia este archivo a .env (en la raíz del proyecto, junto al pom.xml) y rellena los valores
# reales. El .env NUNCA se commitea — ya debe estar en tu .gitignore.

SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (Postgres en Docker Compose local, perfil dev) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olimpiadas369
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- JWT ---
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60

# --- Proveedor de visión (gemini | claude) ---
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash

# --- Firebase (Storage de imágenes + Admin SDK) ---
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# JSON del service account, codificado en base64: base64 -i serviceAccountKey.json
FIREBASE_CREDENTIALS_BASE64=

# --- Correo (invitación de usuarios) ---
# Si usas Gmail con 2FA necesitas una "contraseña de aplicación", no tu password normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@olimpiadas369.com

# --- CORS (frontend Angular) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

SERVER_PORT=8080
